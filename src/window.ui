<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="AzurevpnWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Azure VPN</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
          </object>
        </child>
        <property name="content">
          <!-- Hlavný vertikálny kontajner -->
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            
            <!-- Connection settings group -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Pripojenie</property>
                <child>
                  <object class="AdwComboRow" id="connections_combo">
                    <property name="title" translatable="yes">Uložené pripojenia</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Manual connection form -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Nastavenia pripojenia</property>
                <child>
                  <object class="AdwEntryRow" id="connection_name_entry">
                    <property name="title" translatable="yes">Názov</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="user_entry">
                    <property name="title" translatable="yes">Používateľ</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="host_entry">
                    <property name="title" translatable="yes">Adresa</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="port_entry">
                    <property name="title" translatable="yes">SSH Port</property>
                    <property name="text">22</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="key_file_entry">
                    <property name="title" translatable="yes">SSH Kľúč</property>
                    <property name="text">~/.ssh/id_rsa</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="local_port_entry">
                    <property name="title" translatable="yes">Lokálny SOCKS Port</property>
                    <property name="text">1080</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <!-- Horizontálny kontajner pre tlačidlá -->
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">12</property>
                <property name="halign">center</property>

                <child>
                  <object class="GtkButton" id="save_connection_button">
                    <property name="label" translatable="yes">Uložiť pripojenie</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="delete_connection_button">
                    <property name="label" translatable="yes">Zmazať pripojenie</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <!-- VPN control buttons -->
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">12</property>
                <property name="halign">center</property>

                <child>
                  <object class="GtkButton" id="zapni_vpn_button">
                    <property name="label" translatable="yes">Zapni VPN</property>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="vypni_vpn_button">
                    <property name="label" translatable="yes">Vypni VPN</property>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="proxy_button">
                    <property name="label" translatable="yes">Proxy</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Log area -->
              <object class="GtkScrolledWindow">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkTextView" id="log_view">
                    <property name="editable">False</property>
                    <property name="wrap-mode">word</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>