{
  "id": "org.gnome.gsettingstest",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "gsettingstest",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "gsettingstest",
      "builddir": true,
      "buildsystem": "meson",
      "build-commands": [
        "pip3 install --prefix=/app paramiko --no-build-isolation"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "/home/predrag/Projekty/gsettingsTest"
        }
      ]
    }
  ]
}
